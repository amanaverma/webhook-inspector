{
  "name": "@wi/api",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "worker": "node --env-file-if-exists=../../.env dist/worker-main.js",
    "worker:dev": "node --env-file-if-exists=../../.env --import tsx --watch src/worker-main.ts"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@wi/db": "*",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "undici": "^6.28.1",
    "zod": "^4.5.4"
  }
}
