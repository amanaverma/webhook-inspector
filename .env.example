DATABASE_URL=postgres://wi:wi@localhost:5433/webhook_inspector
PORT=3000
REDIS_URL=redis://localhost:6380
RETENTION_DAYS=7

# Forwarding to localhost is normal in development. Startup refuses it when
# NODE_ENV is production, along with a missing REDIS_URL or METRICS_TOKEN.
FORWARD_ALLOW_PRIVATE=true

# Set to require a bearer token on /metrics.
# METRICS_TOKEN=

# Set behind a load balancer to the addresses or ranges of the proxies in front
# of this process, so client addresses come from x-forwarded-for. A hop count or
# `true` is refused, since either lets a caller choose its own address.
# TRUST_PROXY=10.0.0.0/8,loopback
