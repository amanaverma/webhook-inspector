DATABASE_URL=postgres://wi:wi@localhost:5433/webhook_inspector
PORT=3000
REDIS_URL=redis://localhost:6380
RETENTION_DAYS=7

# Forwarding to localhost is normal in development and refused in production.
FORWARD_ALLOW_PRIVATE=true

# Set to require a bearer token on /metrics.
# METRICS_TOKEN=

# Set behind a load balancer so client addresses come from x-forwarded-for.
# TRUST_PROXY=true
